# Application Settings
APP_NAME=AI Career Operating System
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security
SECRET_KEY=your_super_secret_jwt_key_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Inside Docker Compose)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/career_os

# CORS
BACKEND_CORS_ORIGINS=*

# Module 4 — AI Career Intelligence (Free Tier: Google Gemini & Groq)
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Free-Tier API Keys
GOOGLE_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

