# Application Settings
APP_NAME=AI Career Operating System
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security
SECRET_KEY=your_super_secret_jwt_key_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Inside Docker Compose)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/career_os

# CORS
BACKEND_CORS_ORIGINS=*

# Module 4 — AI Career Intelligence (LangChain & LangGraph)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_REASONING_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
