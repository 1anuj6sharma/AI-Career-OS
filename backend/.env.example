# Application Settings
APP_NAME=AI Career Operating System
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security
SECRET_KEY=your_super_secret_jwt_key_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Inside Docker: postgresql+psycopg://postgres:postgres@postgres:5432/career_os)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/career_os

# Redis
REDIS_URL=redis://localhost:6379

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Module 4 — AI Career Intelligence & LangChain / LangGraph Configuration
LLM_PROVIDER=openai # openai, google, anthropic, groq
LLM_MODEL=gpt-4o-mini
LLM_REASONING_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
VECTOR_STORE=chromadb
